# ---- domínio (aponte o DNS A para o IP da VPS antes de subir) ----
DOMAIN=bot.suaempresa.com.br
EVOLUTION_DOMAIN=whats.suaempresa.com.br

# pasta do projeto transformsite (criada com `transformsite init`)
PROJECT_DIR=./projeto

# ---- LLM local (VPS sem GPU: modelo pequeno; com GPU: qwen3.6:35b-a3b ou similar) ----
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3

# ---- painel admin ----
ADMIN_TOKEN=troque-por-um-token-longo

# ---- Telegram (crie o bot no @BotFather) ----
TELEGRAM_BOT_TOKEN=

# ---- WhatsApp via Evolution API (self-hosted) ----
EVOLUTION_VERSION=v2.2.3
EVOLUTION_API_KEY=troque-por-uma-chave-longa
EVOLUTION_DB_PASSWORD=troque-esta-senha

# ---- e-mail (opcional; sem SMTP os e-mails ficam em data/outbox) ----
SMTP_PASSWORD=
IMAP_PASSWORD=
